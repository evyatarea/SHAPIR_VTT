# Shapir Recordings System - Environment Configuration Example
# Copy this file to .env and fill in actual values for development/production

# API Configuration
DEBUG=False
API_TITLE="Shapir Recordings API"
API_VERSION="1.0.0"
HOST=0.0.0.0
PORT=8000
RELOAD=False

# OpenAI API Configuration (REQUIRED)
OPENAI_API_KEY=sk-...your-openai-api-key-here...
OPENAI_MODEL_SUMMARY=gpt-4-turbo-preview
OPENAI_MODEL_WHISPER=whisper-1

# Database Configuration (SQL Server)
# Example for Windows: mssql+pyodbc://username:password@SERVER_NAME/database_name?driver=ODBC+Driver+17+for+SQL+Server
DATABASE_URL=mssql+pyodbc://sa:Password123@localhost/shapir_recordings?driver=ODBC+Driver+17+for+SQL+Server

# Windows AD / LDAP Configuration
AD_SERVER=ldap://shapir.local:389
AD_BASE_DN=dc=shapir,dc=local
AD_BIND_DN=svc_recordings@shapir.local
AD_BIND_PASSWORD=ServiceAccountPassword123

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=100
ALLOWED_EXTENSIONS=["mp3", "m4a", "wav", "ogg", "webm"]

# Session & Authentication
SESSION_SECRET_KEY=your-super-secret-key-change-this-in-production
SESSION_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Retention Policy
RETENTION_DAYS=30

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# CORS Origins (for React frontend)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000", "https://localhost"]
